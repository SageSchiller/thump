#!/usr/bin/env python3
"""Find out whether the SMC-PAD Pocket's pad lights can be driven over MIDI.

Sends four light patterns to the pad, a few seconds each. Watch the pad and
note which numbered tests did something. Works over USB or Bluetooth.

Run: tools/test-lights        (add --fast to skip the pauses, for testing)
"""
import re
import subprocess
import sys
import time

FAST = "--fast" in sys.argv


def wait(sec):
    if not FAST:
        time.sleep(sec)


def pad_ports():
    out = subprocess.run(["aconnect", "-o"], capture_output=True, text=True).stdout
    ports, client = [], None
    for line in out.splitlines():
        m = re.match(r"client (\d+): '([^']*)'", line)
        if m:
            client = m.group(1) if re.search(r"SMC-PAD|SINCO", m.group(2)) else None
            continue
        m = re.match(r"\s+(\d+) '([^']*)'", line)
        if m and client:
            ports.append((f"{client}:{m.group(1)}", m.group(2).strip()))
    return ports


def send_all(msgs):
    data = " ".join(f"{b:02X}" for msg in msgs for b in msg)
    for port, _ in PORTS:
        subprocess.run(["aseqsend", "-p", port, data], capture_output=True)


def send(status, note, vel):
    send_all([(status, note, vel)])


def all_off():
    send_all([(0x80 | ch, note, 0) for ch in (0, 9) for note in list(range(0, 16)) + list(range(36, 52))])


def phase(n, what):
    print(f"\nTest {n}: {what}", flush=True)
    wait(1.5)


PORTS = pad_ports()
if not PORTS:
    sys.exit("No SMC-PAD found. Turn the pad on, plug it in or connect it over Bluetooth, and try again.")
print("Sending to: " + ", ".join(f"{name} ({port})" for port, name in PORTS))
print("Watch the pad. Each test starts 1.5 seconds after its line appears.")

phase(1, "pads light up ONE AT A TIME, bottom left to top right (MIDI channel 10)")
for i in range(16):
    send(0x99, 36 + i, 127)
    wait(0.2)
wait(1)
all_off()

phase(2, "pads light up one at a time the OTHER WAY, top right to bottom left (channel 1)")
for i in reversed(range(16)):
    send(0x90, 36 + i, 127)
    wait(0.2)
wait(1)
all_off()

phase(3, "ALL pads at once for 4 seconds, each sent a different strength (different colors?)")
for i in range(16):
    send(0x99, 36 + i, 1 + i * 8 + (6 if i == 15 else 0))
wait(4)
all_off()

phase(4, "all pads BLINK three times (notes 0 to 15, channel 1)")
for _ in range(3):
    send_all([(0x90, i, 127) for i in range(16)])
    wait(0.5)
    all_off()
    wait(0.5)

all_off()
print("\nDone. Tell Claude which tests (1, 2, 3, 4) did anything, and what you saw.")
